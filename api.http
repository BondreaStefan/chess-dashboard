### Create a coach
POST http://localhost:8080/api/v1/coaches
Content-Type: application/json

{
  "firstName": "Vasile",
  "lastName": "Popescu",
  "email": "vasile.popescu@example.com"
}

### Create a coach with invalid data
POST http://localhost:8080/api/v1/coaches
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Popescu",
  "email": "nu-este-email"
}

### PUT — schimbă numele
PUT http://localhost:8080/api/v1/coaches/1
Content-Type: application/json

{
  "firstName": "Ioan",
  "lastName": "Popescu"
}

### PUT — firstName gol (așteptat 400)
PUT http://localhost:8080/api/v1/coaches/1
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Popescu"
}

### PUT — id inexistent (așteptat 404)
PUT http://localhost:8080/api/v1/coaches/999
Content-Type: application/json

{
  "firstName": "Ioan",
  "lastName": "Popescu"
}


### List all coaches
GET http://localhost:8080/api/v1/coaches

### Get coach by id
GET http://localhost:8080/api/v1/coaches/1

### Delete coach
DELETE http://localhost:8080/api/v1/coaches/1

### Create student (with coach)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Stefan",
  "lastName": "Bondrea",
  "email": "stefan.bondrea@example.com",
  "coachId": 2,
  "lichessUsername": "VipStef",
  "chessComUsername": "S-Bondrea"
}

### Create student (unassigned, no online accounts)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Maria",
  "lastName": "Georgescu",
  "email": "maria.georgescu@example.com"
}

### Create student — duplicate email (expect 409)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Alt",
  "lastName": "Nume",
  "email": "andrei.ionescu@example.com"
}

### Create student — duplicate lichess username (expect 409)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Alt",
  "lastName": "Nume",
  "email": "unic@example.com",
  "lichessUsername": "andrei_chess"
}

### Create student — non-existent coach (expect 404)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Test",
  "email": "test@example.com",
  "coachId": 999
}

### Create student — invalid email (expect 400 with errors.email)
POST http://localhost:8080/api/v1/students
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Test",
  "email": "nu-este-email"
}

### List all students
GET http://localhost:8080/api/v1/students

### List students by coach
GET http://localhost:8080/api/v1/students?coachId=2

### List students by non-existent coach (expect 404)
GET http://localhost:8080/api/v1/students?coachId=999

### Get student by id
GET http://localhost:8080/api/v1/students/1

### Get student — not found (expect 404)
GET http://localhost:8080/api/v1/students/999

### Update student — same lichess username (expect 200, not 409)
PUT http://localhost:8080/api/v1/students/1
Content-Type: application/json

{
  "firstName": "Andrei-Mihai",
  "lastName": "Ionescu",
  "lichessUsername": "andrei_chess"
}

### Assign coach
PUT http://localhost:8080/api/v1/students/1/coach
Content-Type: application/json

{
  "coachId": 2
}

### Unassign coach
PUT http://localhost:8080/api/v1/students/1/coach
Content-Type: application/json

{
  "coachId": null
}

### Assign non-existent coach (expect 404)
PUT http://localhost:8080/api/v1/students/2/coach
Content-Type: application/json

{
  "coachId": 999
}

### Delete student
DELETE http://localhost:8080/api/v1/students/2

### Create game — color deduced from chess.com username
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "studentId": 2,
  "pgn": "[Event \"Live Chess\"]\n[Site \"Chess.com\"]\n[Date \"2026.08.30\"]\n[Round \"?\"]\n[White \"S-Bondrea\"]\n[Black \"Rookin-Good\"]\n[Result \"1-0\"]\n[TimeControl \"900+10\"]\n[WhiteElo \"1430\"]\n[BlackElo \"1400\"]\n[ECO \"B21\"]\n[EndTime \"16:37:47 GMT+0000\"]\n\n1. e4 c5 2. d4 cxd4 3. c3 e6 4. cxd4 d5 1-0"
}

### Create game — explicit color
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "studentId": 1,
  "studentColor": "BLACK",
  "pgn": "[Event \"Club Tournament\"]\n[Date \"2026.05.10\"]\n[White \"Ionescu, Andrei\"]\n[Black \"Popescu, Ion\"]\n[Result \"0-1\"]\n\n1. d4 Nf6 2. c4 e6 0-1"
}

### Create game — no color, no username match (expect 400)
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "studentId": 1,
  "pgn": "[Event \"Club Tournament\"]\n[Date \"2026.05.10\"]\n[White \"Cineva\"]\n[Black \"Altcineva\"]\n[Result \"1-0\"]\n\n1. e4 e5 1-0"
}

### Create game — invalid PGN (expect 400)
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "studentId": 1,
  "pgn": "acesta nu este un PGN"
}

### Create game — missing studentId (expect 400 with errors.studentId)
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "pgn": "[Result \"1-0\"]\n\n1. e4 e5 1-0",
  "studentColor": "WHITE"
}

### Create game — non-existent student (expect 404)
POST http://localhost:8080/api/v1/games
Content-Type: application/json

{
  "studentId": 999,
  "studentColor": "WHITE",
  "pgn": "[Result \"1-0\"]\n\n1. e4 e5 1-0"
}

### Get game by id
GET http://localhost:8080/api/v1/games/1

### Get game — not found (expect 404)
GET http://localhost:8080/api/v1/games/999

